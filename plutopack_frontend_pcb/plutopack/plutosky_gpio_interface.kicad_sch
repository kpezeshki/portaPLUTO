	(text "The PlutoSky has 8 1V8 GPIO and 4 3V3 GPIO.\nWe use the 3V3 GPIO for SDI, SDO, C/D, RST\nWe use the 1V8 GPIO for display CS, MCU CS, status LEDs\nLooking through the shady gdrive schematics, we have:\n\nP/N: XC7Z020CLG400\n\n3.3V IO0: IO_L20N\n3.3V IO1: IO_L16P\n3.3V IO2: IO_L12N\n3.3V IO3: IO_L12P\n\n1.8V IO0: IO_L18P_T2\n1.8V IO1: IO_L18N_T2\n1.8V IO2: IO_L14P_T2_SRCC\n1.8V IO3: IO_L14N_T2_SRCC\n1.8V IO4: IO_L13P_T2_MRCC\n1.8V IO5: IO_L13N_T2_MRCC\n1.8V IO6: IO_L22P_T3\n1.8V IO7: IO_L22N_T3\n"
		(exclude_from_sim no)
		(at 275.844 41.91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "9d5b5173-0ab4-4da8-a8c7-db7d52812024")
	)
