# PlutoPack FPGA build environment — copy to env.sh and edit for your machine.
#   cp env.sh.example env.sh   &&   $EDITOR env.sh
# env.sh is git-ignored so your local tool paths never get committed.

# Xilinx Vivado 2025.2 settings script (adjust to your install prefix).
export VIVADO_SETTINGS="/opt/Xilinx/Vivado/2025.2/settings64.sh"

# Python venv that has Amaranth HDL + maia-hdl installed (used to generate the
# maia-sdr IP cores). setup.sh can create this for you; see fpga/README.md.
export MAIA_HDL_VENV="$HOME/.venvs/maia-hdl"

# ADI HDL library skips its strict Vivado-version check when this is set.
export ADI_IGNORE_VERSION_CHECK=1
